diff --git a/sglang_omni/models/fishaudio_drama3/npu_attention.py b/sglang_omni/models/fishaudio_drama3/npu_attention.py
new file mode 100644
index 0000000..01bfdb6
--- /dev/null
+++ b/sglang_omni/models/fishaudio_drama3/npu_attention.py
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Scoped FP32 recurrent-state prefill for the experimental 910B port."""
+
+from types import MethodType
+
+import torch
+from sgl_kernel_npu.fla.chunk import chunk_gated_delta_rule_npu
+from sglang.srt.hardware_backend.npu.attention.ascend_gdn_backend import (
+    AscendGDNAttnBackend,
+)
+
+
+def chunk_gdn(
+    backend: AscendGDNAttnBackend,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    initial_state: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, None]:
+    if backend.forward_metadata.has_mamba_track_mask:
+        raise NotImplementedError("DRAMA-3 NPU prefill does not support radix tracking")
+    elif q.shape[-1] != v.shape[-1] or initial_state.dtype != torch.float32:
+        raise ValueError(
+            "DRAMA-3 NPU prefill requires equal K/V dimensions and FP32 state"
+        )
+    else:
+        output, final_state, _ = chunk_gated_delta_rule_npu(
+            q=q.unsqueeze(0),
+            k=k.unsqueeze(0),
+            v=v.unsqueeze(0),
+            g=g.unsqueeze(0),
+            beta=beta.unsqueeze(0),
+            initial_state=initial_state,
+            cu_seqlens=cu_seqlens,
+            use_qk_l2norm_in_kernel=True,
+            output_final_state=True,
+        )
+        return output.squeeze(0), final_state, None
+
+
+def install_prefill(backend: AscendGDNAttnBackend) -> None:
+    if not isinstance(backend, AscendGDNAttnBackend):
+        raise TypeError("Expected Ascend GDN backend")
+    else:
+        backend.chunk_gdn = MethodType(chunk_gdn, backend)
diff --git a/sglang_omni/models/fishaudio_drama3/npu_quantization.py b/sglang_omni/models/fishaudio_drama3/npu_quantization.py
new file mode 100644
index 0000000..17eebff
--- /dev/null
+++ b/sglang_omni/models/fishaudio_drama3/npu_quantization.py
@@ -0,0 +1,62 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Load the original block-FP8 experts into the Ascend BF16 MoE runner."""
+
+import torch
+from sglang.srt.layers.quantization.fp8 import Fp8MoEMethod
+from sglang.srt.layers.quantization.unquant import UnquantizedFusedMoEMethod
+
+
+def expand_expert_blocks(weight: torch.Tensor, scales: torch.Tensor) -> torch.Tensor:
+    """CPU expansion avoids unsupported FP8 arithmetic on Ascend 910B.
+
+    Expand one expert at a time, retaining float32 scale multiplication before
+    the single BF16 rounding. Loading keeps the upstream FP8 shard mapping.
+    """
+    experts, rows, columns = weight.shape
+    expected = (experts, (rows + 127) // 128, (columns + 127) // 128)
+    if tuple(scales.shape) != expected:
+        raise ValueError(f"FP8 scale shape {tuple(scales.shape)} != {expected}")
+    else:
+        pass
+    expanded = torch.empty(weight.shape, dtype=torch.bfloat16, device="cpu")
+    for expert in range(experts):
+        source = weight[expert].cpu().float()
+        scale = scales[expert].cpu().float()
+        for row in range(0, rows, 128):
+            row_scales = scale[row // 128].repeat_interleave(128)[:columns]
+            expanded[expert, row : row + 128] = source[
+                row : row + 128
+            ] * row_scales.unsqueeze(0)
+    return expanded
+
+
+class AscendExpertFp8Method(Fp8MoEMethod):
+    """FP8 checkpoint loader with BF16 execution; no extra weight quantization."""
+
+    def __init__(self, quant_config):
+        super().__init__(quant_config)
+        if self.weight_block_size != [128, 128] or self.is_fp4_expert:
+            raise ValueError("DRAMA-3 NPU port requires 128x128 block-FP8 experts")
+        else:
+            pass
+        self.unquantized = UnquantizedFusedMoEMethod()
+
+    def create_moe_runner(self, layer, moe_runner_config):
+        self.moe_runner_config = moe_runner_config
+        self.unquantized.create_moe_runner(layer, moe_runner_config)
+        self.runner = self.unquantized.runner
+
+    def process_weights_after_loading(self, layer):
+        for prefix in ("w13", "w2"):
+            weight = getattr(layer, f"{prefix}_weight")
+            scales = getattr(layer, f"{prefix}_weight_scale_inv")
+            expanded = expand_expert_blocks(weight, scales)
+            setattr(
+                layer,
+                f"{prefix}_weight",
+                torch.nn.Parameter(expanded.to(weight.device), requires_grad=False),
+            )
+        self.unquantized.process_weights_after_loading(layer)
+
+    def apply(self, layer, dispatch_output):
+        return self.unquantized.apply(layer, dispatch_output)
